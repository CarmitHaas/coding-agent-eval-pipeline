# --- inference ---
NEBIUS_API_KEY=XXX

# --- docker compose deployment (VM) ---
# id -u
AIRFLOW_UID=1000
# getent group docker | cut -d: -f3
DOCKER_GID=988
# absolute path of this repo on the host (DockerOperator mounts it into task containers)
HOST_PROJECT_DIR=/home/user/coding-agent-eval-pipeline
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# openssl rand -hex 32
AIRFLOW_JWT_SECRET=change-me

# --- object storage for run artifacts (optional; upload skipped when unset) ---
# Nebius Object Storage is S3-protocol-compatible; these are Nebius-issued
# service-account keys, not AWS credentials.
S3_BUCKET=
S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
